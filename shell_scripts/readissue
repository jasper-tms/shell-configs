#!/usr/bin/env python3
"""Print the full thread (body + all comments) for one or more GitHub issues
or pull requests -- as readable Markdown, or as JSON -- in a single API call.

For pull requests the thread also includes everything from code review: review
summaries (approve / request changes / comment, with their text) and line
comments on the diff (with file, line, a few lines of the code they point at,
and every reply), merged into one timeline with the ordinary comments. The
header also names the head and base branches.

Designed to be run by an agent (or a human) that wants to read several issues'
complete discussions at once without fumbling with multiple `gh` commands.

Usage:
    readissue <repo> <numbers> [--json]
    readissue <numbers> [--json]          # when current folder is a repo, omit the repo argument
    readissue <issue-or-pr-url> [--json]  # repo and number both from the URL

<repo> may be given as 'owner/name', as a full GitHub URL, e.g.
'https://github.com/jasper-tms/shell-configs', or as an SSH remote, e.g.
'git@github.com:jasper-tms/shell-configs.git'. A full issue or pull-request URL
like 'https://github.com/jasper-tms/shell-configs/issues/6' supplies both the
repo and the number, so pasting one URL is enough to read that one thread.

<numbers> is one or more issue/PR numbers separated by commas and/or spaces,
and may include inclusive ranges. All of these are equivalent ways to ask for
issues 1, 6, 7 and 8:
    readissue jasper-tms/shell-configs 1,6,7,8
    readissue jasper-tms/shell-configs 1 6 7 8
    readissue jasper-tms/shell-configs 1,6-8
    readissue https://github.com/jasper-tms/shell-configs 1,6-8

Called with no issue numbers (just a repo, or nothing inside a repo checkout),
it instead lists the repo's open issues -- number and title, one per line --
above the usage text, as a menu of what's available to read.

Every requested number is fetched in ONE GraphQL request regardless of how many
there are, so reading 40 issues costs the same round trip as reading one.

With --json, prints a JSON array of cleaned issue objects using the SAME schema
as backup_github_issues' `_clean_and_combine.py` (number, title, html_url,
state, user, labels, created_at, updated_at, closed_at, body, is_pull_request,
comments[]), so the two tools' output is interchangeable. Pull requests carry
these extra keys on top: head_ref, base_ref, is_draft, merged_at, reviews[]
(user, html_url, state, submitted_at, body) and review_threads[] (path, line,
start_line, original_line, original_start_line, is_resolved, is_outdated,
diff_hunk, comments[]).

Requires the GitHub CLI (`gh`) to be installed and authenticated; it provides
the auth for the underlying API call.
"""

import json
import re
import subprocess
import sys

# Number of comments fetched per issue. GitHub's GraphQL API caps a single page
# at 100; issues with more than this are reported as truncated rather than
# paginated (vanishingly rare for the repos this is used on).
COMMENTS_PER_ISSUE = 100
# Pull-request review limits, with the same truncation reporting. GitHub
# rejects a query whose worst-case node count (threads x comments per thread,
# summed over every requested number) exceeds 500,000, so comments per thread
# stays modest to keep ranges like '1-100' working.
REVIEWS_PER_PULL_REQUEST = 100
THREADS_PER_PULL_REQUEST = 100
COMMENTS_PER_THREAD = 25
# Lines of diff shown above each line-comment thread, ending at the commented
# line (GitHub's diff hunk runs from the hunk start, which can be hundreds of
# lines for a new file).
DIFF_CONTEXT_LINES = 10

USAGE = (
    "Usage: readissue <repo> <numbers> [--json]\n"
    "       readissue <numbers> [--json]          (when current folder is a repo, omit the repo argument)\n"
    "       readissue <issue-or-pr-url> [--json]  (repo and number from the URL)\n"
    "\n"
    "  <repo>:    Can be 'owner/name', a GitHub URL like 'https://github.com/jasper-tms/shell-configs',\n"
    "             or an SSH remote like 'git@github.com:jasper-tms/shell-configs.git'.\n"
    "  <numbers>: Issue/PR numbers separated by commas and/or spaces,\n"
    "             ranges allowed, e.g. '1,6,8' or '1 6 8' or '1-3,8'.\n"
    "  --json:    Emit a JSON array instead of Markdown."
)


def fail(message):
    """Print an error to stderr and exit non-zero."""
    print(f"readissue: {message}", file=sys.stderr)
    sys.exit(1)


_GH_MISSING = (
    "the GitHub CLI (gh) was not found on PATH. Install it from "
    "https://cli.github.com/ and run 'gh auth login'."
)


def run_gh(arguments):
    """Run a `gh` command, returning its stdout. Exits with a clear message if
    gh is missing, unauthenticated, or the command fails."""
    try:
        result = subprocess.run(
            ["gh", *arguments], capture_output=True, text=True
        )
    except FileNotFoundError:
        fail(_GH_MISSING)
    if result.returncode != 0:
        message = (result.stderr or result.stdout or "").strip()
        fail(f"gh command failed:\n{message}")
    return result.stdout


def run_graphql(query):
    """Run a GraphQL query and return its parsed JSON payload. A number that
    doesn't exist comes back as a null node plus a harmless NOT_FOUND error,
    and gh exits non-zero whenever the response carries ANY error -- but the
    full JSON (data and errors together) is still on stdout, so parse that
    rather than trusting the exit code. Only errors other than NOT_FOUND (a bad
    repo, auth trouble, a malformed query) are treated as fatal."""
    try:
        result = subprocess.run(
            ["gh", "api", "graphql", "-f", f"query={query}"],
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        fail(_GH_MISSING)
    stdout = result.stdout.strip()
    if not stdout:
        fail(f"gh command failed:\n{(result.stderr or '').strip()}")
    try:
        payload = json.loads(stdout)
    except json.JSONDecodeError:
        fail(f"could not parse gh response:\n{stdout}")
    fatal = [
        error
        for error in payload.get("errors", [])
        if error.get("type") != "NOT_FOUND"
    ]
    if fatal:
        messages = "; ".join(error.get("message", "?") for error in fatal)
        fail(f"GraphQL error(s): {messages}")
    return payload


def looks_like_repo(token):
    """A repo argument looks like 'owner/name'; a numbers argument never does."""
    return bool(re.fullmatch(r"[^/\s]+/[^/\s]+", token))


# A GitHub URL in any of its usual spellings: the https web URL, and the SSH
# remote forms 'git@github.com:owner/name.git' (scp-like) and
# 'ssh://git@github.com/owner/name'. The pieces: an optional scheme, an optional
# 'git@' user and 'www.', the host, then either ':' (scp-like) or '/' before
# 'owner/name' (with an optional '.git'). A web URL may carry a trailing
# '/issues/<n>' or '/pull/<n>', and a trailing slash and any '?query' or
# '#fragment' (e.g. '#issuecomment-...') are tolerated and ignored.
_GITHUB_URL = re.compile(
    r"(?:(?:https?|ssh)://)?(?:git@)?(?:www\.)?github\.com[:/]"
    r"(?P<owner>[^/\s]+)/(?P<name>[^/\s]+?)(?:\.git)?"
    r"(?:/(?:issues|pull)/(?P<number>\d+))?"
    r"/?(?:[?#].*)?"
)


def parse_repo_url(token):
    """If `token` is a GitHub URL -- an https web URL or an SSH remote -- return
    (owner/name, number_or_None): a repo URL yields a None number, while a full
    issue or pull-request URL yields the number embedded in it. Returns None for
    anything that is not a GitHub URL."""
    match = _GITHUB_URL.fullmatch(token)
    if not match:
        return None
    repo = f"{match.group('owner')}/{match.group('name')}"
    number = match.group("number")
    return repo, int(number) if number is not None else None


def parse_numbers(tokens):
    """Turn the positional argv tokens into an ordered, de-duplicated list of
    issue numbers. Tokens may be comma- and/or space-separated and may contain
    inclusive 'A-B' ranges."""
    numbers = []
    seen = set()
    for token in tokens:
        for piece in token.split(","):
            piece = piece.strip()
            if not piece:
                continue
            range_match = re.fullmatch(r"(\d+)-(\d+)", piece)
            if range_match:
                start, end = int(range_match.group(1)), int(range_match.group(2))
                if start > end:
                    start, end = end, start
                candidates = range(start, end + 1)
            elif piece.isdigit():
                candidates = [int(piece)]
            else:
                fail(f"could not parse issue number(s) from {piece!r}.\n\n{USAGE}")
            for number in candidates:
                if number not in seen:
                    seen.add(number)
                    numbers.append(number)
    return numbers


def detect_current_repo():
    """Return 'owner/name' for the repo of the current directory, or None if
    the current directory is not a GitHub repo (gh exits non-zero there)."""
    try:
        result = subprocess.run(
            ["gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"],
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        fail(_GH_MISSING)
    if result.returncode != 0:
        return None
    return result.stdout.strip() or None


def list_open_issues(owner, name):
    """Return a list of (number, title) for the repo's open issues (not PRs),
    sorted by number, plus the total open count (which may exceed the number
    returned if the repo has more than 100 open issues)."""
    query = (
        "query{repository(owner:"
        + json.dumps(owner)
        + ",name:"
        + json.dumps(name)
        + "){issues(first:100,states:OPEN){totalCount nodes{number title}}}}"
    )
    payload = run_graphql(query)
    repository = (payload.get("data") or {}).get("repository")
    if repository is None:
        fail(f"repository {owner}/{name!r} not found or not accessible.")
    issues = repository["issues"]
    nodes = sorted(issues["nodes"], key=lambda node: node["number"])
    return [(node["number"], node["title"]) for node in nodes], issues["totalCount"]


# GraphQL selection of the fields wanted for both issues and pull requests.
# Both types expose these same fields. The names are chosen to map cleanly onto
# the backup_github_issues cleaned schema in clean_node() below.
_THREAD_FIELDS = (
    "number title state url createdAt updatedAt closedAt "
    "author{login} "
    "labels(first:50){nodes{name}} "
    "body "
    f"comments(first:{COMMENTS_PER_ISSUE}){{"
    "totalCount nodes{author{login} url createdAt updatedAt body}"
    "}"
)

# Extra fields fetched only for pull requests: branches, review summaries, and
# line comments grouped into their threads.
_PULL_REQUEST_FIELDS = (
    "headRefName baseRefName isDraft mergedAt "
    f"reviews(first:{REVIEWS_PER_PULL_REQUEST}){{"
    "totalCount nodes{author{login} url state submittedAt body}"
    "} "
    f"reviewThreads(first:{THREADS_PER_PULL_REQUEST}){{"
    "totalCount nodes{path line startLine originalLine originalStartLine "
    "isResolved isOutdated "
    f"comments(first:{COMMENTS_PER_THREAD}){{"
    "totalCount nodes{author{login} url createdAt updatedAt body diffHunk}"
    "}"
    "}"
    "}"
)


def build_query(owner, name, numbers):
    """Build one GraphQL query that fetches every requested number via
    issueOrPullRequest (GitHub numbers issues and PRs in a shared sequence, so
    a given number resolves to whichever it is). __typename tells the two
    apart; a number that exists as neither resolves to null."""
    selections = []
    for number in numbers:
        selections.append(
            f"n{number}: issueOrPullRequest(number:{number})"
            f"{{__typename "
            f"... on Issue{{{_THREAD_FIELDS}}} "
            f"... on PullRequest{{{_THREAD_FIELDS} {_PULL_REQUEST_FIELDS}}}}}"
        )
    return (
        "query{repository(owner:"
        + json.dumps(owner)
        + ",name:"
        + json.dumps(name)
        + "){"
        + " ".join(selections)
        + "}}"
    )


def _login(holder):
    """Pull a `.author.login` out of an issue/comment node, tolerating a null
    author (e.g. a deleted account)."""
    return (holder.get("author") or {}).get("login")


def clean_node(node):
    """Normalize a GraphQL issueOrPullRequest node into the cleaned schema used
    by backup_github_issues' `_clean_and_combine.py`, so Markdown rendering and
    --json output (and, later, the backup itself) can share one shape. Pull
    requests get extra keys (branches, reviews, review threads) on top."""

    def clean_comment(comment):
        return {
            "user": _login(comment),
            "html_url": comment.get("url"),
            "created_at": comment.get("createdAt"),
            "updated_at": comment.get("updatedAt"),
            "body": comment.get("body"),
        }

    cleaned = {
        "number": node.get("number"),
        "title": node.get("title"),
        "html_url": node.get("url"),
        # GraphQL states are upper-case (OPEN/CLOSED/MERGED); the REST-based
        # backup uses lower-case, so match that.
        "state": (node.get("state") or "").lower() or None,
        "user": _login(node),
        "labels": [
            label.get("name")
            for label in (node.get("labels") or {}).get("nodes", [])
        ],
        "created_at": node.get("createdAt"),
        "updated_at": node.get("updatedAt"),
        "closed_at": node.get("closedAt"),
        "body": node.get("body"),
        "is_pull_request": node.get("__typename") == "PullRequest",
        "comments": [
            clean_comment(comment)
            for comment in (node.get("comments") or {}).get("nodes", [])
        ],
    }
    if not cleaned["is_pull_request"]:
        return cleaned

    review_threads = []
    for thread in (node.get("reviewThreads") or {}).get("nodes", []):
        thread_comments = (thread.get("comments") or {}).get("nodes", [])
        review_threads.append({
            "path": thread.get("path"),
            "line": thread.get("line"),
            "start_line": thread.get("startLine"),
            "original_line": thread.get("originalLine"),
            "original_start_line": thread.get("originalStartLine"),
            "is_resolved": thread.get("isResolved"),
            "is_outdated": thread.get("isOutdated"),
            # Every comment in a thread shares the first one's code context.
            "diff_hunk": (
                thread_comments[0].get("diffHunk") if thread_comments else None
            ),
            "comments": [clean_comment(comment) for comment in thread_comments],
        })
    cleaned.update({
        "head_ref": node.get("headRefName"),
        "base_ref": node.get("baseRefName"),
        "is_draft": node.get("isDraft"),
        "merged_at": node.get("mergedAt"),
        "reviews": [
            {
                "user": _login(review),
                "html_url": review.get("url"),
                "state": (review.get("state") or "").lower() or None,
                "submitted_at": review.get("submittedAt"),
                "body": review.get("body"),
            }
            for review in (node.get("reviews") or {}).get("nodes", [])
        ],
        "review_threads": review_threads,
    })
    return cleaned


def truncation_notes(node):
    """Return a list of human-readable notes, one per part of this issue or
    pull request that had more items on GitHub than were fetched. Empty when
    nothing was cut off."""
    notes = []

    def check(connection, limit, what):
        total = (connection or {}).get("totalCount", 0)
        if total > limit:
            notes.append(
                f"{total - limit} more {what} not shown "
                f"(only the first {limit} of {total} are fetched)"
            )

    check(node.get("comments"), COMMENTS_PER_ISSUE, "comment(s)")
    if node.get("__typename") == "PullRequest":
        check(node.get("reviews"), REVIEWS_PER_PULL_REQUEST, "review(s)")
        check(
            node.get("reviewThreads"),
            THREADS_PER_PULL_REQUEST,
            "line-comment thread(s)",
        )
        for thread in (node.get("reviewThreads") or {}).get("nodes", []):
            check(
                thread.get("comments"),
                COMMENTS_PER_THREAD,
                f"line comment(s) in a thread on {thread.get('path')}",
            )
    return notes


def format_review_thread(thread, index):
    """Render one line-comment thread: a heading naming the file and line(s),
    the tail of the diff it points at, then every comment in order."""
    line = thread["line"]
    start_line = thread["start_line"]
    if line is None:
        # The commented code no longer exists in the latest diff, so GitHub
        # only knows where it was in the commit the comment was made on.
        line = thread["original_line"]
        start_line = thread["original_start_line"]
    if line is None:
        location = "(file-level)"
    elif start_line is not None and start_line != line:
        location = f"lines {start_line}–{line}"
    else:
        location = f"line {line}"
    flags = []
    if thread["is_resolved"]:
        flags.append("resolved")
    if thread["is_outdated"]:
        flags.append("outdated: the code has changed since")
    flag_suffix = f" [{', '.join(flags)}]" if flags else ""

    lines = [
        f"### Line comment thread {index} — `{thread['path']}` "
        f"{location}{flag_suffix}"
    ]
    hunk = (thread["diff_hunk"] or "").rstrip("\n")
    if hunk:
        hunk_lines = hunk.split("\n")
        if len(hunk_lines) > DIFF_CONTEXT_LINES:
            hunk_lines = hunk_lines[-DIFF_CONTEXT_LINES:]
        # The fence must be longer than any backtick run inside the diff (a
        # Markdown file's diff can itself contain ``` fences).
        longest_run = max(
            (len(run) for run in re.findall(r"`+", "\n".join(hunk_lines))),
            default=0,
        )
        fence = "`" * max(3, longest_run + 1)
        lines.append(f"{fence}diff")
        lines.extend(hunk_lines)
        lines.append(fence)
    for comment in thread["comments"]:
        author = comment["user"] or "(unknown)"
        lines.append(f"#### @{author} · {comment['created_at'] or '?'}")
        comment_body = (comment["body"] or "").strip()
        lines.append(comment_body if comment_body else "_(empty comment)_")
    lines.append("")
    return lines


def format_markdown(issue, total_comments, notes):
    """Render one cleaned issue dict as a Markdown block. `total_comments` is
    the true comment count on GitHub, which can exceed the number fetched;
    `notes` lists anything else cut off (see `truncation_notes()`). Pull
    requests get one timeline merging comments, reviews and line comments."""
    is_pull_request = issue["is_pull_request"]
    kind = "Pull Request" if is_pull_request else "Issue"
    state = (issue["state"] or "").upper()
    if is_pull_request and issue["is_draft"] and state == "OPEN":
        state = "DRAFT"
    state_suffix = f" [{state}]" if state else ""
    title = issue["title"] or "(no title)"

    lines = [f"# {kind} #{issue['number']}: {title}{state_suffix}"]

    meta = f"by @{issue['user'] or '(unknown)'} · opened {issue['created_at'] or '?'}"
    if is_pull_request:
        meta += f" · branch `{issue['head_ref']}` into `{issue['base_ref']}`"
        if issue["merged_at"]:
            meta += f" · merged {issue['merged_at']}"
    if issue["labels"]:
        meta += " · labels: " + ", ".join(issue["labels"])
    lines.append(meta)
    if issue["html_url"]:
        lines.append(issue["html_url"])
    lines.append("")

    body = (issue["body"] or "").strip()
    lines.append(body if body else "_(no description)_")
    lines.append("")

    # Each timeline entry is (timestamp, rendered lines). GitHub timestamps are
    # all ISO 8601 in UTC, so they sort correctly as strings.
    entries = []
    for index, comment in enumerate(issue["comments"], start=1):
        author = comment["user"] or "(unknown)"
        comment_body = (comment["body"] or "").strip()
        entries.append((comment["created_at"] or "", [
            f"### Comment {index} — @{author} · {comment['created_at'] or '?'}",
            comment_body if comment_body else "_(empty comment)_",
            "",
        ]))
    review_count = 0
    thread_count = 0
    if is_pull_request:
        for review in issue["reviews"]:
            review_body = (review["body"] or "").strip()
            # Leaving line comments creates a 'commented' review with no text
            # of its own; its comments appear under their threads instead.
            if not review_body and review["state"] in ("commented", "pending"):
                continue
            review_count += 1
            author = review["user"] or "(unknown)"
            verdict = (review["state"] or "?").replace("_", " ")
            if review["state"] == "pending":
                verdict += " (not yet submitted, visible only to its author)"
            entries.append((review["submitted_at"] or "", [
                f"### Review {review_count} — @{author} · {verdict} · "
                f"{review['submitted_at'] or '?'}",
                review_body if review_body else "_(no summary text)_",
                "",
            ]))
        for thread in issue["review_threads"]:
            thread_count += 1
            first_time = thread["comments"][0]["created_at"] if thread["comments"] else ""
            entries.append(
                (first_time or "", format_review_thread(thread, thread_count))
            )
    entries.sort(key=lambda entry: entry[0])

    if not entries and total_comments == 0:
        lines.append("_(no comments)_")
    else:
        if is_pull_request:
            lines.append(
                f"## Timeline ({total_comments} comment(s), "
                f"{review_count} review(s), "
                f"{thread_count} line-comment thread(s))"
            )
        else:
            lines.append(f"## Comments ({total_comments})")
        lines.append("")
        for _, entry_lines in entries:
            lines.extend(entry_lines)
    for note in notes:
        lines.append(f"_… {note}._")
        lines.append("")
    return "\n".join(lines).rstrip()


def parse_arguments(argv):
    """Split argv into (repo_or_None, number_tokens, output_json).

    The repo may be an 'owner/name' token, a GitHub repo URL, or a full
    issue/PR URL -- and a full issue/PR URL also contributes its number, so a
    single pasted URL suffices. Two arguments that name different repos are an
    error."""
    output_json = False
    positional = []
    for arg in argv:
        if arg in ("-h", "--help"):
            print(USAGE)
            sys.exit(0)
        if arg in ("--json", "-j"):
            output_json = True
        elif arg in ("--markdown", "--md"):
            output_json = False
        elif arg.startswith("-") and arg != "-":
            fail(f"unknown option {arg!r}.\n\n{USAGE}")
        else:
            positional.append(arg)

    repo = None
    number_tokens = []
    for token in positional:
        parsed = parse_repo_url(token)
        if parsed is not None:
            token_repo, token_number = parsed
        elif looks_like_repo(token):
            token_repo, token_number = token, None
        else:
            number_tokens.append(token)
            continue
        if repo is not None and token_repo != repo:
            fail(
                f"conflicting repositories given: {repo!r} and {token_repo!r}."
                f"\n\n{USAGE}"
            )
        repo = token_repo
        if token_number is not None:
            number_tokens.append(str(token_number))
    return repo, number_tokens, output_json


def show_open_issues_and_usage(repo):
    """For a bare invocation (no issue numbers): list the repo's open issues
    one per line, then the usage text, and exit."""
    if repo is None or "/" not in repo:
        print(USAGE)
        sys.exit(1)
    owner, name = repo.split("/", 1)
    issues, total = list_open_issues(owner, name)
    print(f"Open issues in {repo}:")
    if issues:
        for number, title in issues:
            print(f"  #{number} {title}")
        if total > len(issues):
            print(f"  … and {total - len(issues)} more")
    else:
        print("  (none)")
    print()
    print(USAGE)
    sys.exit(0)


def main():
    repo, number_tokens, output_json = parse_arguments(sys.argv[1:])
    if repo is None:
        repo = detect_current_repo()

    numbers = parse_numbers(number_tokens)
    if not numbers:
        show_open_issues_and_usage(repo)

    if repo is None:
        fail(
            "no repo given and the current directory is not a GitHub repo.\n\n"
            + USAGE
        )
    if "/" not in repo:
        fail(f"repo {repo!r} is not in 'owner/name' form.\n\n{USAGE}")
    owner, name = repo.split("/", 1)

    payload = run_graphql(build_query(owner, name, numbers))
    repository = (payload.get("data") or {}).get("repository")
    if repository is None:
        fail(f"repository {repo!r} not found or not accessible.")

    cleaned_issues = []
    total_comment_counts = []
    notes_per_issue = []
    missing = []
    for number in numbers:
        node = repository.get(f"n{number}")
        if node is None:
            missing.append(number)
            continue
        cleaned_issues.append(clean_node(node))
        total_comment_counts.append(
            (node.get("comments") or {}).get("totalCount", 0)
        )
        notes_per_issue.append(truncation_notes(node))

    if output_json:
        print(json.dumps(cleaned_issues, indent=2))
    else:
        blocks = [
            format_markdown(issue, total, notes)
            for issue, total, notes in zip(
                cleaned_issues, total_comment_counts, notes_per_issue
            )
        ]
        if blocks:
            print(("\n\n" + "-" * 72 + "\n\n").join(blocks))

    for issue, notes in zip(cleaned_issues, notes_per_issue):
        for note in notes:
            print(
                f"readissue: note: #{issue['number']}: {note}.",
                file=sys.stderr,
            )
    if missing:
        joined = ", ".join(f"#{number}" for number in missing)
        print(
            f"readissue: no issue or pull request found for {joined} in {repo}.",
            file=sys.stderr,
        )


if __name__ == "__main__":
    main()
