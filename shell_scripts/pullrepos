#!/bin/bash

# Enable job control so each backgrounded `git pull` gets its own process
# group. That lets pull_with_retry() kill the whole subtree (git plus any
# ssh/http helper it spawned) if a pull hangs, without depending on the
# GNU-only `timeout`/`gtimeout` commands.
set -m

# Never let a pull block on an interactive credential prompt. With HTTPS
# remotes and no cached credentials, `git pull` otherwise tries to read a
# username/password from the controlling terminal -- and with pulls fanned
# out in parallel below, dozens of them would fight over /dev/tty and hang
# until the timeout/retry logic kills them (turning "creds aren't cached"
# into a multi-minute garbled stall). GIT_TERMINAL_PROMPT=0 makes such a
# repo fail instantly with "could not read Username" instead; those repos
# are then collected and reported together at the end. Cached credentials
# still work: credential helpers (store/cache/gh) are consulted before this
# fallback path. Any inherited askpass helper is unset so it can't
# reintroduce a GUI/keychain prompt that hangs.
export GIT_TERMINAL_PROMPT=0
unset GIT_ASKPASS SSH_ASKPASS

pull_timeout_secs=10
pull_max_attempts=3
max_parallel_pulls=16
print_pause_secs=0.05

# Run `git pull` in the current directory, killing and retrying it if it
# doesn't finish within pull_timeout_secs, up to pull_max_attempts times.
# Prints the combined stdout/stderr of the pull (or a failure notice) and
# returns non-zero only if every attempt timed out.
pull_with_retry() {
    local attempt=1
    local tmpfile elapsed pid status
    while [ "$attempt" -le "$pull_max_attempts" ]; do
        tmpfile=$(mktemp)
        git pull >"$tmpfile" 2>&1 &
        pid=$!
        elapsed=0
        while kill -0 "$pid" 2>/dev/null; do
            if [ "$elapsed" -ge "$pull_timeout_secs" ]; then
                kill -TERM -- -"$pid" 2>/dev/null
                sleep 1
                kill -KILL -- -"$pid" 2>/dev/null
                wait "$pid" 2>/dev/null
                rm -f "$tmpfile"
                echo "$(pwd): git pull timed out after ${pull_timeout_secs}s (attempt $attempt/$pull_max_attempts)" >&2
                attempt=$((attempt + 1))
                continue 2
            fi
            sleep 1
            elapsed=$((elapsed + 1))
        done
        wait "$pid"
        status=$?
        cat "$tmpfile"
        rm -f "$tmpfile"
        # Propagate git's own exit status so the caller can tell an auth
        # failure (git exited non-zero, fast) from a real hang (timed out,
        # handled above). Auth failures must NOT be retried -- they're not
        # transient, and retrying just triples the noise.
        return "$status"
    done
    echo "git pull failed: timed out on all $pull_max_attempts attempts" >&2
    return 124
}

verbose=false
repos_dir=
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose)
            verbose=true
            shift
            ;;
        -h|--help)
            echo "Usage: pullrepos [-v|--verbose] [folder]"
            echo
            echo "Run \`git pull\` on every repo found in ~/repos or /workspace/repos."
            echo "Give an optional folder argument (e.g. \`pullrepos .\`) to use that"
            echo "folder as the repo root instead of the default locations."
            echo "By default only repos with something new to report are printed."
            echo "With -v, every repo is printed as it is pulled, even if it was"
            echo "already up to date."
            echo "If a pull takes longer than ${pull_timeout_secs}s it is cancelled and retried,"
            echo "up to $pull_max_attempts attempts total."
            echo "Up to $max_parallel_pulls repos are pulled in parallel."
            echo "Interactive credential prompts are disabled: any repo whose"
            echo "GitHub credentials aren't cached fails instantly (rather than"
            echo "hanging) and is listed in a summary at the end."
            exit 0
            ;;
        -*)
            echo "Unrecognized argument: $1" >&2
            echo "Usage: pullrepos [-v|--verbose] [folder]" >&2
            exit 1
            ;;
        *)
            if [ -n "$repos_dir" ]; then
                echo "Too many arguments: $1" >&2
                echo "Usage: pullrepos [-v|--verbose] [folder]" >&2
                exit 1
            fi
            repos_dir=$1
            shift
            ;;
    esac
done

if [ -n "$repos_dir" ]; then
    if [ ! -d "$repos_dir" ]; then
        echo "Not a directory: $repos_dir" >&2
        exit 1
    fi
    # Resolve to an absolute path so the per-repo `cd` below doesn't break
    # subsequent relative paths (e.g. when the folder given is `.`).
    repos_dir=$(cd "$repos_dir" && pwd)
elif [ -d ~/repos ]; then
    repos_dir=~/repos
elif [ -d /workspace/repos ]; then
    repos_dir=/workspace/repos
else
    echo "No repos directory found at ~/repos or /workspace/repos" >&2
    exit 1
fi
repos_dir=${repos_dir%/}

echo "Running \`git pull\` on all repos within $repos_dir..."
echo

repo_dirs=()
for repo in "$repos_dir"/*/.git "$repos_dir"/*/*/.git; do
    if [ ! -d "$repo" ]; then continue; fi
    repo_dirs+=("${repo%%/.git}")
done
total_repos=${#repo_dirs[@]}

# Pull repos in the background, capped at max_parallel_pulls running at
# once, each buffering its formatted output to its own temp file. This way
# a slow or hung repo doesn't hold up the rest. Below, started-but-not-yet-
# finished jobs are polled, and each one's buffered output is printed as
# soon as it finishes (in completion order, not the order repos were
# found), pacing prints 0.2s apart so two results can never land
# interleaved even though the pulls themselves run concurrently. Timeout/
# retry notices from pull_with_retry are not buffered here -- they print to
# stderr in real time, tagged with their repo path, since that's the
# information most useful while pulls are still in flight.
pids=()
result_files=()
auth_files=()
auth_failures=()
started=0
finished=0
while [ "$finished" -lt "$total_repos" ]; do
    while [ "$started" -lt "$total_repos" ] && [ "$(jobs -rp | wc -l)" -lt "$max_parallel_pulls" ]; do
        repo_dir=${repo_dirs[$started]}
        result_file=$(mktemp)
        auth_fail_file=$(mktemp)
        (
            # Re-assert job control: a background job started inside a
            # subshell that is itself backgrounded does not get its own
            # process group on its own, even though -m is inherited from
            # the parent shell. Without this, pull_with_retry's
            # kill -- -"$pid" targets a process group that was never
            # created, silently fails, and the hung `git pull` only ever
            # stops when it finishes on its own.
            set -m
            cd "$repo_dir" || exit 1
            output=$(pull_with_retry)
            status=$?
            if [ "$status" -ne 0 ] && printf '%s' "$output" | grep -qiE 'could not read (Username|Password)|terminal prompts disabled|Authentication failed|Invalid username or (token|password)'; then
                # Credentials aren't cached/valid. Keep the raw git error out
                # of the streaming output and record this repo for the
                # end-of-run "needs authentication" summary instead.
                printf '%s\n' "$repo_dir" >"$auth_fail_file"
            elif [ "$output" = "Already up to date." ]; then
                if [ "$verbose" = true ]; then
                    echo "$repo_dir"
                    echo "$output"
                    echo
                fi
            else
                echo "$repo_dir"
                echo "$output"
                echo
            fi
        ) >"$result_file" &
        pids[$started]=$!
        result_files[$started]=$result_file
        auth_files[$started]=$auth_fail_file
        started=$((started + 1))
    done

    dispatched=false
    for idx in "${!pids[@]}"; do
        pid=${pids[$idx]}
        if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
            wait "$pid" 2>/dev/null
            cat "${result_files[$idx]}"
            rm -f "${result_files[$idx]}"
            if [ -s "${auth_files[$idx]}" ]; then
                auth_failures+=("$(cat "${auth_files[$idx]}")")
            fi
            rm -f "${auth_files[$idx]}"
            pids[$idx]=
            finished=$((finished + 1))
            dispatched=true
            sleep "$print_pause_secs"
            break
        fi
    done
    if [ "$dispatched" = false ]; then
        sleep 0.2
    fi
done

# Report any repos that couldn't authenticate, all together at the end so
# they aren't lost among the streamed per-repo output. All remotes here are
# HTTPS, so an uncached machine fails every repo the same way -- one clear
# summary with a fix hint beats N interleaved git errors.
if [ "${#auth_failures[@]}" -gt 0 ]; then
    echo
    echo "Could not authenticate to GitHub for ${#auth_failures[@]} repo(s):"
    for repo_dir in "${auth_failures[@]}"; do
        echo "  - $repo_dir"
    done
    echo
    echo "Credentials aren't cached. Set them up once, then re-run pullrepos:"
    echo "  gh auth login                                  # recommended, or"
    echo "  git config --global credential.helper store    # cache them on disk"
fi
